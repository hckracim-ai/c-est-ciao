rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Deux utilisateurs sont amis si une amitié existe dans un sens ou dans l'autre.
    // dmId = uid1_uid2 (triés par ordre alphabétique)
    function dmFriends(dmId) {
      let p = dmId.split('_');
      return p.size() == 2 && (
        exists(/databases/$(database)/documents/friendships/$(p[0] + '_' + p[1])) ||
        exists(/databases/$(database)/documents/friendships/$(p[1] + '_' + p[0])));
    }

    // Profils : lisibles par les utilisateurs connectés, modifiables par leur propriétaire
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 32
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 150000))
        && (!('bannerURL' in request.resource.data) || (request.resource.data.bannerURL is string && request.resource.data.bannerURL.size() < 300000));
      allow delete: if false;
    }

    // Unicité des noms d'utilisateur : usernames/{nom} -> { uid }
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Demandes d'ami : id = "{expéditeur}_{destinataire}"
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Amitiés : créées par le destinataire d'une demande existante (même id)
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && exists(/databases/$(database)/documents/requests/$(id))
        && get(/databases/$(database)/documents/requests/$(id)).data.to == request.auth.uid;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Groupes + messages
    match /groups/{gid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);

      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }

    // Messages privés entre amis
    match /dms/{dmId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create, update: if signedIn()
        && request.auth.uid in dmId.split('_')
        && dmFriends(dmId)
        && request.resource.data.users.size() == 2
        && request.resource.data.users.hasAll(dmId.split('_'))
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 120;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in dmId.split('_');
        allow create: if signedIn()
          && request.auth.uid in dmId.split('_')
          && dmFriends(dmId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }

    // Appels (signalisation WebRTC)
    match /calls/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow read, update: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);

      match /{sub}/{cid} {
        allow read, write: if signedIn() && (
          get(/databases/$(database)/documents/calls/$(id)).data.from == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(id)).data.to == request.auth.uid);
      }
    }
  }
}
